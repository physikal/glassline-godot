; Engine configuration file.
; Godot 4.3+  — Glassline (Hex Sniper) client spike

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=false

[application]

config/name="Glassline"
config/description="Hex Sniper client spike — MockMatchServer default, optional live HTTPS+SSE"
config/version="0.1.0"
run/main_scene="res://scenes/lobby/hideout_lobby.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

ClientSession="*res://autoload/client_session.gd"
MockMatchServer="*res://autoload/mock_match_server.gd"
LiveMatchClient="*res://autoload/live_match_client.gd"
MatchAPI="*res://autoload/match_api.gd"

[glassline]

use_live_api=false
api_base_url="http://127.0.0.1:8787"

[debug]

gdscript/warnings/inferred_declaration=0
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
